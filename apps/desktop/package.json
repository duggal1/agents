{
  "name": "@sapphire/desktop",
  "productName": "Sapphire",
  "version": "0.1.6",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "runtime:build": "node scripts/build-runtime.mjs",
    "pack": "bun --filter @sapphire/web build && bun run build && bun run runtime:build && electron-builder --mac --win --linux",
    "pack:dir": "bun --filter @sapphire/web build && bun run build && bun run runtime:build && electron-builder --dir",
    "pack:run": "rm -rf out && bun --filter @sapphire/web build && bun run build && electron-builder --dir && open out/mac-arm64/Sapphire.app",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "bun run build && playwright test --config e2e/playwright.config.ts",
    "release": "bun --filter @sapphire/web build && bun run build && bun run runtime:build && electron-builder --publish never"
  },
  "dependencies": {
    "@sapphire/contracts": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sapphire/ui-tokens": "workspace:*",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "dev.rakazo.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../runtime",
        "to": "runtime"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "../../packages/ui-tokens/assets/Rakazo.icon",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "sapphire",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elie222",
        "repo": "rakazo"
      }
    ]
  }
}
